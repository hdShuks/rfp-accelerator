# --- SEC EDGAR ---
# REQUIRED. SEC blocks requests without a descriptive User-Agent.
# Format: "Company/Project Name your-email@example.com"
EDGAR_USER_AGENT="RFP Accelerator (dev) your-email@example.com"

# --- Anthropic ---
# Local dev fallback only. Leave UNSET in the public deploy so the tool is
# strictly bring-your-own-key (users paste their key in the UI).
ANTHROPIC_API_KEY=""

# --- Cost control ---
# Hard ceiling per orchestration run. The runner halts and reports if exceeded.
MAX_RUN_USD="0.50"

# Number of fiscal years to pull from EDGAR companyfacts.
EDGAR_YEARS="5"
