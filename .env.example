# --- SEC EDGAR ---
# REQUIRED. SEC blocks requests without a descriptive User-Agent.
# Format: "Company/Project Name your-email@example.com"
EDGAR_USER_AGENT="RFP Accelerator (dev) your-email@example.com"

# --- Anthropic ---
# How the app reaches Claude, in priority order:
#   1. a key pasted in the UI (per-request, never stored server-side)
#   2. ANTHROPIC_API_KEY below
#   3. "local subscription mode" — the `claude` CLI logged into your Pro/Max
#      plan (local dev only; never on Vercel). Spend counts against your plan.
#
# Leave this UNSET here (local dev) so local runs fall through to mode 3 —
# your Pro/Max subscription — instead of spending API credits. On the Vercel
# deployment, SET this (Project Settings -> Environment Variables) to a real
# console.anthropic.com key so the deployed link and the Lovable frontend
# (which just calls that deployment's API) work without anyone pasting a
# key. Bounded per run by MAX_RUN_USD below; that exposure is the accepted
# trade-off for a private/unlisted link. See DEPLOY.md.
ANTHROPIC_API_KEY=""

# Force API-only (skip local subscription mode even if the CLI is present):
#   RFP_LLM_MODE="api"
# Point at a specific claude binary if it's not on PATH:
#   RFP_CLAUDE_BIN="/absolute/path/to/claude"

# --- Cost control ---
# Hard ceiling per orchestration run. The runner halts and reports if exceeded.
MAX_RUN_USD="0.50"

# Number of fiscal years to pull from EDGAR companyfacts.
EDGAR_YEARS="5"
